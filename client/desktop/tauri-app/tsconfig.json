{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@/shared/*": [
        "../shared/*"
      ],
      "@quanux/shared/*": [
        "../../src/*"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
