{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuanuX Desktop",
  "version": "0.0.1",
  "identifier": "dev.quantdiy.quanux.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QuanuX",
        "width": 1200,
        "height": 800
      }
    ],
    "trayIcon": {
      "iconPath": "icons/tray-light.png",
      "iconAsTemplate": false
    }
  },
  "bundle": {
    "targets": "all"
  },
  "plugins": {}
}