# QuanuX environment (example) — copy to .env and adjust.
# Do NOT commit real secrets.

# Server bind
QUANUX_BIND_HOST=0.0.0.0
QUANUX_BIND_PORT=8080

# Security modes
QUANUX_AUTH_MODE=webauthn|yubikey|oauth2
QUANUX_MTLS_ENABLED=false

# Secrets broker selection (ordered fallback)
QUANUX_SECRETS_BACKENDS=keyring,vault,redis-cache

# Redis (cache-only for secrets; not a source of truth)
REDIS_URL=redis://localhost:6379/0

# Hashing/Signing (rotate regularly)
QUANUX_SIGNING_KEY_ID=local-dev-key
QUANUX_JWT_ISSUER=https://quanux.local
QUANUX_JWT_AUDIENCE=quanux-client

# Example third-party (store via secrets broker at runtime; placeholders only)
TRADINGVIEW_CLIENT_ID=
TRADINGVIEW_CLIENT_SECRET=
BROKER_API_KEY=
BROKER_API_SECRET=

# --- AI Providers (env names only; store values via Secrets Broker) ---
