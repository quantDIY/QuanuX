# QuanuX Server Configuration
# Copy this file to .env and fill in your secrets.
# Keys are mapped to ServerConfig in server/app/config.py
# Format: QUANUX__[SECTION]__[KEY]

# Server Settings
QUANUX_ENV=dev
QUANUX_BIND_PORT=8080

# Security
QUANUX__SECURITY__AUTH_MODE="webauthn|yubikey|oauth2"

# Topstep Integration (Secrets)
QUANUX__TOPSTEP__USERNAME="YOUR_TOPSTEP_USERNAME"
QUANUX__TOPSTEP__API_KEY="YOUR_TOPSTEP_API_KEY"
QUANUX__TOPSTEP__BASE_API_URL="https://api.topstepx.com"
