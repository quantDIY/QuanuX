.nh
.TH "QXCTL" "1" "Mar 2026" "QuanuX Hardware Bounds" "QuanuX Operator Manual"

.SH NAME
qxctl-predeploy - Performs a Capability Handshake prior to deployment natively


.SH SYNOPSIS
\fBqxctl predeploy [flags]\fP


.SH DESCRIPTION
Performs a Capability Handshake prior to deployment natively


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for predeploy

.PP
\fB-p\fP, \fB--payload\fP=""
	Execution context payload

.PP
\fB-t\fP, \fB--target\fP=""
	Node target array

.PP
\fB--type\fP="extension"
	Deployment bounds mode


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	Explicit config file trajectory

.PP
\fB--hub\fP="nats://127.0.0.1:4222"
	QuanuX JetStream Engine Hub target

.PP
\fB--output\fP="text"
	Set the output UX mode (text, json, yaml, quiet)

.PP
\fB--trace\fP[=false]
	Enable extreme diagnostic observability bounds

.PP
\fB--verbose\fP[=false]
	Enable verbose payload outputs


.SH SEE ALSO
\fBqxctl(1)\fP
