.TH "QXCTL" "1" "Mar 2026" "QuanuX Hardware Bounds" "QuanuX Operator Manual"

.SH NAME
qxctl-topstepx - Manage TopstepX Extension natively


.SH SYNOPSIS
\fBqxctl topstepx [flags]\fP


.SH DESCRIPTION
Manage TopstepX Extension natively


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for topstepx


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	Explicit config file trajectory

.PP
\fB--hub\fP="nats://127.0.0.1:4222"
	QuanuX JetStream Engine Hub target

.PP
\fB--output\fP="text"
	Set the output UX mode (text, json, yaml, quiet)

.PP
\fB--trace\fP[=false]
	Enable extreme diagnostic observability bounds

.PP
\fB--verbose\fP[=false]
	Enable verbose payload outputs


.SH SEE ALSO
\fBqxctl(1)\fP, \fBqxctl-topstepx-apikey(1)\fP, \fBqxctl-topstepx-env(1)\fP, \fBqxctl-topstepx-install(1)\fP, \fBqxctl-topstepx-market-hub(1)\fP, \fBqxctl-topstepx-password(1)\fP, \fBqxctl-topstepx-remove(1)\fP, \fBqxctl-topstepx-user(1)\fP, \fBqxctl-topstepx-user-hub(1)\fP
