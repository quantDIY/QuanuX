.nh
.TH "QXCTL" "1" "Mar 2026" "QuanuX Hardware Bounds" "QuanuX Operator Manual"

.SH NAME
qxctl-vcs-commit - Commit changes to the local repository


.SH SYNOPSIS
\fBqxctl vcs commit [flags]\fP


.SH DESCRIPTION
Commit changes to the local repository


.SH OPTIONS
\fB-a\fP, \fB--all\fP[=false]
	Stage all modified files

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for commit

.PP
\fB-m\fP, \fB--message\fP=""
	Commit message


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	Explicit config file trajectory

.PP
\fB--hub\fP="nats://127.0.0.1:4222"
	QuanuX JetStream Engine Hub target

.PP
\fB--output\fP="text"
	Set the output UX mode (text, json, yaml, quiet)

.PP
\fB--trace\fP[=false]
	Enable extreme diagnostic observability bounds

.PP
\fB--verbose\fP[=false]
	Enable verbose payload outputs


.SH SEE ALSO
\fBqxctl-vcs(1)\fP
