.TH "QXCTL" "1" "Mar 2026" "QuanuX Hardware Bounds" "QuanuX Operator Manual"

.SH NAME
qxctl-infra-set-token - Securely saves the DigitalOcean API Token to the native OS Keyring (Zero-Disk storage)


.SH SYNOPSIS
\fBqxctl infra set-token [token] [flags]\fP


.SH DESCRIPTION
Securely saves the DigitalOcean API Token to the native OS Keyring (Zero-Disk storage)


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for set-token

.PP
\fB--target\fP="gcp"
	Target bound to evaluate against.


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	Explicit config file trajectory

.PP
\fB--hub\fP="nats://127.0.0.1:4222"
	QuanuX JetStream Engine Hub target

.PP
\fB--output\fP="text"
	Set the output UX mode (text, json, yaml, quiet)

.PP
\fB--trace\fP[=false]
	Enable extreme diagnostic observability bounds

.PP
\fB--verbose\fP[=false]
	Enable verbose payload outputs


.SH SEE ALSO
\fBqxctl-infra(1)\fP
