.nh
.TH "QXCTL" "1" "Mar 2026" "QuanuX Hardware Bounds" "QuanuX Operator Manual"

.SH NAME
qxctl-bridge-start - Start the SignalR bridge process


.SH SYNOPSIS
\fBqxctl bridge start [flags]\fP


.SH DESCRIPTION
Start the SignalR bridge process


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for start

.PP
\fB-p\fP, \fB--port\fP=8077
	Port to bind the bridge to.

.PP
\fB-r\fP, \fB--runtime\fP="flask"
	Runtime to use: 'flask' or 'node'.


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	Explicit config file trajectory

.PP
\fB--hub\fP="nats://127.0.0.1:4222"
	QuanuX JetStream Engine Hub target

.PP
\fB--output\fP="text"
	Set the output UX mode (text, json, yaml, quiet)

.PP
\fB--trace\fP[=false]
	Enable extreme diagnostic observability bounds

.PP
\fB--verbose\fP[=false]
	Enable verbose payload outputs


.SH SEE ALSO
\fBqxctl-bridge(1)\fP
