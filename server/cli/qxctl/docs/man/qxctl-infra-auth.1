.nh
.TH "QXCTL" "1" "Mar 2026" "QuanuX Hardware Bounds" "QuanuX Operator Manual"

.SH NAME
qxctl-infra-auth - Outputs export commands for QECD Phase 3 Terraform Provisioning


.SH SYNOPSIS
\fBqxctl infra auth [flags]\fP


.SH DESCRIPTION
Outputs export commands for QECD Phase 3 Terraform Provisioning


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for auth

.PP
\fB--target\fP="gcp"
	Infrastructure target (do or gcp)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	Explicit config file trajectory

.PP
\fB--hub\fP="nats://127.0.0.1:4222"
	QuanuX JetStream Engine Hub target

.PP
\fB--output\fP="text"
	Set the output UX mode (text, json, yaml, quiet)

.PP
\fB--trace\fP[=false]
	Enable extreme diagnostic observability bounds

.PP
\fB--verbose\fP[=false]
	Enable verbose payload outputs


.SH SEE ALSO
\fBqxctl-infra(1)\fP
