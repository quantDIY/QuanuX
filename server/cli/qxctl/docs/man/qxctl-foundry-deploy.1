.nh
.TH "QXCTL" "1" "Mar 2026" "QuanuX Hardware Bounds" "QuanuX Operator Manual"

.SH NAME
qxctl-foundry-deploy - Vendor code and push a fully self-sovereign artifact to an Execution Node


.SH SYNOPSIS
\fBqxctl foundry deploy [flags]\fP


.SH DESCRIPTION
Vendor code and push a fully self-sovereign artifact to an Execution Node


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for deploy

.PP
\fB-n\fP, \fB--node\fP=""
	Remote Node ID mapping

.PP
\fB-t\fP, \fB--target\fP=""
	Strategy variant to deploy


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	Explicit config file trajectory

.PP
\fB--hub\fP="nats://127.0.0.1:4222"
	QuanuX JetStream Engine Hub target

.PP
\fB--output\fP="text"
	Set the output UX mode (text, json, yaml, quiet)

.PP
\fB--trace\fP[=false]
	Enable extreme diagnostic observability bounds

.PP
\fB--verbose\fP[=false]
	Enable verbose payload outputs


.SH SEE ALSO
\fBqxctl-foundry(1)\fP
