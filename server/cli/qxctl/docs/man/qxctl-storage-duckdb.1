.SH NAME
qxctl-storage-duckdb - Manage DuckDB cartridges statically


.SH SYNOPSIS
\fBqxctl storage duckdb [flags]\fP


.SH DESCRIPTION
Manage DuckDB cartridges statically


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for duckdb


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	Explicit config file trajectory

.PP
\fB--hub\fP="nats://127.0.0.1:4222"
	QuanuX JetStream Engine Hub target

.PP
\fB--output\fP="text"
	Set the output UX mode (text, json, yaml, quiet)

.PP
\fB--trace\fP[=false]
	Enable extreme diagnostic observability bounds

.PP
\fB--verbose\fP[=false]
	Enable verbose payload outputs


.SH SEE ALSO
\fBqxctl-storage(1)\fP, \fBqxctl-storage-duckdb-attach(1)\fP, \fBqxctl-storage-duckdb-detach(1)\fP, \fBqxctl-storage-duckdb-init(1)\fP
