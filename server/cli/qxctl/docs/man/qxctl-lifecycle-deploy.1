.nh
.TH "QXCTL" "1" "Mar 2026" "QuanuX Hardware Bounds" "QuanuX Operator Manual"

.SH NAME
qxctl-lifecycle-deploy - Deploys a payload into the outer shell (Habitat) safely using valid wiring hooks


.SH SYNOPSIS
\fBqxctl lifecycle deploy [flags]\fP


.SH DESCRIPTION
Deploys a payload into the outer shell (Habitat) safely using valid wiring hooks


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for deploy

.PP
\fB-p\fP, \fB--payload\fP=""
	Path to payload directory

.PP
\fB-t\fP, \fB--target\fP=""
	Target Node Hostname

.PP
\fB--type\fP="extension"
	Payload Type


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	Explicit config file trajectory

.PP
\fB--hub\fP="nats://127.0.0.1:4222"
	QuanuX JetStream Engine Hub target

.PP
\fB--output\fP="text"
	Set the output UX mode (text, json, yaml, quiet)

.PP
\fB--trace\fP[=false]
	Enable extreme diagnostic observability bounds

.PP
\fB--verbose\fP[=false]
	Enable verbose payload outputs


.SH SEE ALSO
\fBqxctl-lifecycle(1)\fP
