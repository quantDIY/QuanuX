.nh
.TH "QXCTL" "1" "Mar 2026" "QuanuX Hardware Bounds" "QuanuX Operator Manual"

.SH NAME
qxctl-habitat-sentinel - Deploys the strict Low-Overhead Sentinel Protocol (Telegraf & Promtail)


.SH SYNOPSIS
\fBqxctl habitat sentinel [target] [flags]\fP


.SH DESCRIPTION
Deploys the strict Low-Overhead Sentinel Protocol (Telegraf & Promtail)


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for sentinel

.PP
\fB--telemetry-interval\fP="15s"
	Telemetry reporting interval for Telegraf


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	Explicit config file trajectory

.PP
\fB--hub\fP="nats://127.0.0.1:4222"
	QuanuX JetStream Engine Hub target

.PP
\fB--output\fP="text"
	Set the output UX mode (text, json, yaml, quiet)

.PP
\fB--trace\fP[=false]
	Enable extreme diagnostic observability bounds

.PP
\fB--verbose\fP[=false]
	Enable verbose payload outputs


.SH SEE ALSO
\fBqxctl-habitat(1)\fP
