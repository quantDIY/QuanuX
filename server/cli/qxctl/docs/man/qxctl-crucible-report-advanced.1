.nh
.TH "QXCTL" "1" "Mar 2026" "QuanuX Hardware Bounds" "QuanuX Operator Manual"

.SH NAME
qxctl-crucible-report-advanced - Retrieve Phase 5 Deep Statistical Analysis directly from the C++ Engine via Cython


.SH SYNOPSIS
\fBqxctl crucible report-advanced [strategy] [flags]\fP


.SH DESCRIPTION
Retrieve Phase 5 Deep Statistical Analysis directly from the C++ Engine via Cython


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for report-advanced

.PP
\fB--mc-iterations\fP=1000
	Number of Monte Carlo resampling iterations.

.PP
\fB--version\fP="1.0.0"
	The version of the strategy.


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	Explicit config file trajectory

.PP
\fB--hub\fP="nats://127.0.0.1:4222"
	QuanuX JetStream Engine Hub target

.PP
\fB--output\fP="text"
	Set the output UX mode (text, json, yaml, quiet)

.PP
\fB--trace\fP[=false]
	Enable extreme diagnostic observability bounds

.PP
\fB--verbose\fP[=false]
	Enable verbose payload outputs


.SH SEE ALSO
\fBqxctl-crucible(1)\fP
