.nh
.TH "QXCTL" "1" "Mar 2026" "QuanuX Hardware Bounds" "QuanuX Operator Manual"

.SH NAME
qxctl-orchestra-compile - Executes standardizer_cli, generating the C++ constexpr bridge, the Cython wrappers, and embedding the checksums


.SH SYNOPSIS
\fBqxctl orchestra compile [flags]\fP


.SH DESCRIPTION
Executes standardizer_cli, generating the C++ constexpr bridge, the Cython wrappers, and embedding the checksums


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for compile

.PP
\fB-v\fP, \fB--venue\fP=""
	The broker venue to compile (e.g. ibkr)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	Explicit config file trajectory

.PP
\fB--hub\fP="nats://127.0.0.1:4222"
	QuanuX JetStream Engine Hub target

.PP
\fB--output\fP="text"
	Set the output UX mode (text, json, yaml, quiet)

.PP
\fB--trace\fP[=false]
	Enable extreme diagnostic observability bounds

.PP
\fB--verbose\fP[=false]
	Enable verbose payload outputs


.SH SEE ALSO
\fBqxctl-orchestra(1)\fP
