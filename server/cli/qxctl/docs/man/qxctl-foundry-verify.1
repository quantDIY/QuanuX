.TH "QXCTL" "1" "Mar 2026" "QuanuX Hardware Bounds" "QuanuX Operator Manual"

.SH NAME
qxctl-foundry-verify - Trigger the Deterministic Sandbox for mathematical equivalence testing


.SH SYNOPSIS
\fBqxctl foundry verify [flags]\fP


.SH DESCRIPTION
Trigger the Deterministic Sandbox for mathematical equivalence testing


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for verify

.PP
\fB-t\fP, \fB--target\fP=""
	Name of the strategy/component to verify


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	Explicit config file trajectory

.PP
\fB--hub\fP="nats://127.0.0.1:4222"
	QuanuX JetStream Engine Hub target

.PP
\fB--output\fP="text"
	Set the output UX mode (text, json, yaml, quiet)

.PP
\fB--trace\fP[=false]
	Enable extreme diagnostic observability bounds

.PP
\fB--verbose\fP[=false]
	Enable verbose payload outputs


.SH SEE ALSO
\fBqxctl-foundry(1)\fP
