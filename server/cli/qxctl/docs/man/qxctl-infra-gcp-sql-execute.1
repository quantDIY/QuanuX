.nh
.TH "QXCTL" "1" "Mar 2026" "QuanuX Hardware Bounds" "QuanuX Operator Manual"

.SH NAME
qxctl-infra-gcp-sql-execute - Validates, transpiles, and executes bounded SQL against BigQuery


.SH SYNOPSIS
\fBqxctl infra gcp-sql execute [query] [flags]\fP


.SH DESCRIPTION
Validates, transpiles, and executes bounded SQL against BigQuery


.SH OPTIONS
\fB--dry-run\fP[=false]
	Validate and transpile only, do not send to GCP

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for execute

.PP
\fB--json\fP[=false]
	Emit purely JSON payload for machine execution

.PP
\fB--max-rows\fP=100
	Maximum rows to fetch remotely

.PP
\fB--timeout\fP=30
	Timeout in seconds for remote execution


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	Explicit config file trajectory

.PP
\fB--hub\fP="nats://127.0.0.1:4222"
	QuanuX JetStream Engine Hub target

.PP
\fB--output\fP="text"
	Set the output UX mode (text, json, yaml, quiet)

.PP
\fB--trace\fP[=false]
	Enable extreme diagnostic observability bounds

.PP
\fB--verbose\fP[=false]
	Enable verbose payload outputs


.SH SEE ALSO
\fBqxctl-infra-gcp-sql(1)\fP
