.nh
.TH "QXCTL" "1" "Mar 2026" "QuanuX Hardware Bounds" "QuanuX Operator Manual"

.SH NAME
qxctl-nest-drop - Deploys the C++ execution logic into a pre-conditioned OS Habitat


.SH SYNOPSIS
\fBqxctl nest drop [target] [flags]\fP


.SH DESCRIPTION
Deploys the C++ execution logic into a pre-conditioned OS Habitat


.SH OPTIONS
\fB--engine\fP="spreader"
	Engine type to compile and bind

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for drop


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	Explicit config file trajectory

.PP
\fB--hub\fP="nats://127.0.0.1:4222"
	QuanuX JetStream Engine Hub target

.PP
\fB--output\fP="text"
	Set the output UX mode (text, json, yaml, quiet)

.PP
\fB--trace\fP[=false]
	Enable extreme diagnostic observability bounds

.PP
\fB--verbose\fP[=false]
	Enable verbose payload outputs


.SH SEE ALSO
\fBqxctl-nest(1)\fP
