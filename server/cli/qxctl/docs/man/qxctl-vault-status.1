.TH "QXCTL" "1" "Mar 2026" "QuanuX Hardware Bounds" "QuanuX Operator Manual"

.SH NAME
qxctl-vault-status - Interrogates the live Annex C++ daemon bounding the Sovereign Vault and NVMe chunk cache


.SH SYNOPSIS
\fBqxctl vault status [flags]\fP


.SH DESCRIPTION
Interrogates the live Annex C++ daemon bounding the Sovereign Vault and NVMe chunk cache


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for status

.PP
\fB--target\fP="gcp"
	Infrastructure target (do or gcp)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	Explicit config file trajectory

.PP
\fB--hub\fP="nats://127.0.0.1:4222"
	QuanuX JetStream Engine Hub target

.PP
\fB--output\fP="text"
	Set the output UX mode (text, json, yaml, quiet)

.PP
\fB--trace\fP[=false]
	Enable extreme diagnostic observability bounds

.PP
\fB--verbose\fP[=false]
	Enable verbose payload outputs


.SH SEE ALSO
\fBqxctl-vault(1)\fP
