{
  "strategy_name": "CLZ4_CLF5_Spread",
  "legs": [
    {"instrument_id": 0, "symbol": "CLZ4", "multiplier": 1.0},
    {"instrument_id": 1, "symbol": "CLF5", "multiplier": -1.0}
  ],
  "state_variables": [
    {"name": "entry_threshold", "type": "double", "initial_value": 0.05},
    {"name": "current_spread", "type": "double", "initial_value": 0.0}
  ],
  "logic_gates": {
    "calculate_spread": "state.current_spread = tick.price;",
    "entry_condition": "state.current_spread > state.entry_threshold",
    "exit_condition": "state.current_spread < 0"
  }
}
