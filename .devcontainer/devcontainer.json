{
  "name": "QuanuX Dev",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/rust:1": {
      "profile": "minimal",
      "version": "latest"
    }
  },
  "forwardPorts": [5173, 5174, 1420, 3000, 8000],
  "mounts": [
    "source=pnpm-cache,target=/home/vscode/.cache/pnpm,type=volume",
    "source=cargo-registry-cache,target=/home/vscode/.cargo/registry,type=volume",
    "source=cargo-git-cache,target=/home/vscode/.cargo/git,type=volume"
  ],
  "postCreateCommand": "bash .devcontainer/postCreate.sh",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss"
      ],
      "settings": {
        "npm.packageManager": "pnpm"
      }
    }
  }
}
