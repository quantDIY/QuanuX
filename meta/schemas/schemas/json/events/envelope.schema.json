{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event Envelope",
  "type": "object",
  "required": [
    "event_type",
    "sequence",
    "correlation_id",
    "source",
    "timestamp",
    "payload"
  ],
  "properties": {
    "event_type": {
      "type": "string"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "correlation_id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false
}